# Hardhat deployer key — fund this with Monad Testnet MON before deploying
PRIVATE_KEY=0xyour_deployer_private_key

# Address that the badge contract trusts to sign claim vouchers.
# Set this to the address derived from the backend signer key.
VERIFIER_ADDRESS=0xyour_backend_signer_address

# Optional RPC override (defaults to https://testnet-rpc.monad.xyz)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
