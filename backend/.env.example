# Backend signer key — its address must equal VERIFIER_ADDRESS set on the
# ProofDropBadge contract. Generate one and copy the matching public address
# into contracts/.env before deploying.
SIGNER_PRIVATE_KEY=0xreplace_me

# Address of the deployed ProofDropBadge contract on Monad Testnet
BADGE_CONTRACT_ADDRESS=0xreplace_after_deploy

# Monad Testnet chain id
CHAIN_ID=10143

# How long a signed voucher stays valid (seconds)
VOUCHER_TTL_SECONDS=900

# CORS — comma-separated origins allowed to hit the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- OpenAI (optional) ----
# When OPENAI_API_KEY is set, task grading + proof verification call the LLM.
# When unset (or the call fails), the backend falls back to heuristic scoring.
OPENAI_API_KEY=
# Use any model your key has access to. Must support vision for image proofs.
# gpt-4o-mini is the cheapest vision-capable model (default).
OPENAI_MODEL=gpt-4o-mini
# Individually disable either feature without removing the API key.
LLM_GRADING_ENABLED=1
LLM_PROOF_ENABLED=1
